<?xml version="1.0" encoding="utf-8"?>
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <ProjectGuid>{A1B2C3D4-E5F6-7890-ABCD-EF1234567890}</ProjectGuid>
    <ProjectVersion>17.0</ProjectVersion>
    <FrameworkType>VCL</FrameworkType>
    <MainSource>StickyNotes.dpr</MainSource>
    <Base>True</Base>
    <Config Condition="'$(Config)'==''">Debug</Config>
    <Platform Condition="'$(Platform)'==''">Win32</Platform>
    <TargetedPlatforms>1</TargetedPlatforms>
    <AppType>Application</AppType>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Config)'=='Debug' Or '$(Config)'=='Release'">
    <Platform>Win32</Platform>
    <Config>Debug</Config>
    <DebugSymbols>True</DebugSymbols>
    <DefineDebug>True</DefineDebug>
    <DefineRelease>False</DefineRelease>
    <Optimization>False</Optimization>
    <OutputDir>.\Win32\Debug</OutputDir>
    <UnitOutputDir>.\Win32\Debug</UnitOutputDir>
    <PackageDLLOutputDir>.\Win32\Debug</PackageDLLOutputDir>
    <PackageDCPOutputDir>.\Win32\Debug</PackageDCPOutputDir>
    <SearchPath>$(BDSLIB)\Win32\debug;$(BDSUSERDIR)\Imports;$(BDSCOMMONDIR)\Dcp\Win32</SearchPath>
    <ConditionalDefines>DEBUG;$(DCC_Define)</ConditionalDefines>
    <UseDebugDCUs>True</UseDebugDCUs>
    <GenerateStackFrames>True</GenerateStackFrames>
    <DebugInfoInExe>True</DebugInfoInExe>
    <RemoteDebug>False</RemoteDebug>
    <RemotePath>
    </RemotePath>
    <RemoteHost>
    </RemoteHost>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Config)'=='Release'">
    <DebugSymbols>False</DebugSymbols>
    <DefineDebug>False</DefineDebug>
    <DefineRelease>True</DefineRelease>
    <Optimization>True</Optimization>
    <OutputDir>.\Win32\Release</OutputDir>
    <UnitOutputDir>.\Win32\Release</UnitOutputDir>
    <PackageDLLOutputDir>.\Win32\Release</PackageDLLOutputDir>
    <PackageDCPOutputDir>.\Win32\Release</PackageDCPOutputDir>
    <SearchPath>$(BDSLIB)\Win32\release;$(BDSUSERDIR)\Imports;$(BDSCOMMONDIR)\Dcp\Win32</SearchPath>
    <ConditionalDefines>RELEASE;$(DCC_Define)</ConditionalDefines>
    <UseDebugDCUs>False</UseDebugDCUs>
    <GenerateStackFrames>False</GenerateStackFrames>
    <DebugInfoInExe>False</DebugInfoInExe>
  </PropertyGroup>
  <ItemGroup>
    <DelphiCompile Include="StickyNotes.dpr">
      <MainSource>MainSource</MainSource>
    </DelphiCompile>
    <BuildConfiguration Include="Debug">
      <Key>Debug</Key>
      <CfgType>Debug</CfgType>
    </BuildConfiguration>
    <BuildConfiguration Include="Release">
      <Key>Release</Key>
      <CfgType>Release</CfgType>
    </BuildConfiguration>
  </ItemGroup>
  <ItemGroup>
    <Compile Include="Models\uNote.pas" />
    <Compile Include="Models\uSettings.pas" />
    <Compile Include="Models\uEnums.pas" />
    <Compile Include="Controllers\uNoteManager.pas" />
    <Compile Include="Controllers\uTrayController.pas" />
    <Compile Include="Controllers\uSettingsController.pas" />
    <Compile Include="Storage\uStorage.pas" />
    <Compile Include="Storage\uJsonStorage.pas" />
    <Compile Include="Storage\uSQLiteStorage.pas" />
    <Compile Include="Services\uAutosaveService.pas" />
    <Compile Include="Services\uHotkeyService.pas" />
    <Compile Include="Services\uStartupService.pas" />
    <Compile Include="Services\uThemeService.pas" />
    <Compile Include="Services\uBackupService.pas" />
    <Compile Include="Application\uNoteApplication.pas" />
    <Compile Include="Application\uNoteEditorContext.pas" />
    <Compile Include="Utils\uWindowUtils.pas" />
    <Compile Include="Utils\uJsonUtils.pas" />
    <Compile Include="Utils\uIso8601.pas" />
    <Compile Include="Utils\uColorUtils.pas" />
    <Compile Include="Utils\uMonitorUtils.pas" />
    <Compile Include="Forms\uNoteForm.pas">
      <Form>Form</Form>
    </Compile>
    <Compile Include="Forms\uTrayForm.pas">
      <Form>Form</Form>
    </Compile>
    <Compile Include="Forms\uSettingsForm.pas">
      <Form>Form</Form>
    </Compile>
    <Compile Include="Forms\uAboutForm.pas">
      <Form>Form</Form>
    </Compile>
  </ItemGroup>
  <ItemGroup>
    <FormResource Include="Forms\uNoteForm.dfm" />
    <FormResource Include="Forms\uTrayForm.dfm" />
    <FormResource Include="Forms\uSettingsForm.dfm" />
    <FormResource Include="Forms\uAboutForm.dfm" />
  </ItemGroup>
  <ItemGroup>
    <None Include="Resources\StickyNotes.rc" />
  </ItemGroup>
  <Import Project="$(BDS)\Bin\CodeGear.Delphi.Targets" Condition="Exists('$(BDS)\Bin\CodeGear.Delphi.Targets')" />
  <Import Project="$(APPDATA)\Embarcadero\$(BDSAPPDATABASEDIR)\$(PRODUCTVERSION)\UserTools.proj" Condition="Exists('$(APPDATA)\Embarcadero\$(BDSAPPDATABASEDIR)\$(PRODUCTVERSION)\UserTools.proj')" />
</Project>
